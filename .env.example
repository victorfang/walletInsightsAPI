# Supply values through your shell/secret manager or explicit --env-file .env.
# The explicit file configures both walletAgeDays and WalletInsights.
# Uncomment only the settings you use and replace the placeholder values.
# ALCHEMY_API_KEY=YOUR_ALCHEMY_KEY
# Alternatively, set a full HTTPS URL instead of the Alchemy API key.
# ALCHEMY_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
# QUICKNODE_RPC_URL=https://YOUR_ENDPOINT.quiknode.pro/YOUR_QUICKNODE_TOKEN/
# walletAgeDays uses a new compact permanent epoch database (no TTL cache).
# WALLET_AGE_DB=/path/to/wallet-age-days.sqlite3
# Requires the QuickNode Token and NFT API v2 add-on; disabled by default.
# WALLET_AGE_QUICKNODE_HISTORY=1
# Optional local HTTP authentication: incoming x-api-key must match this value.
# WALLET_CHECK_API_KEY=YOUR_LOCAL_SERVICE_KEY
# WalletInsights keeps mutable snapshots and AnChain labels separate from age.
# WALLET_INSIGHTS_DB=/path/to/wallet-insights.sqlite3
# ANCHAIN_DATA_API_BASE_URL=https://api.anchainai.com
# ANCHAIN_DATA_API_KEY=YOUR_ANCHAIN_KEY
# ANCHAIN_API_KEY is also accepted.
# Existing provider config names supported by both endpoints:
# QUICKNODE_ETH_URL=https://YOUR_ENDPOINT.quiknode.pro/YOUR_TOKEN/
# QUICKNODE_ETH_AUTH_TOKEN=YOUR_OPTIONAL_X_TOKEN
